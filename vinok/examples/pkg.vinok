# DAVINOC - Package Manifest
# Test: [] objects without commas (newline-separated)

name = "dv-quest"

version = "0.1.0"

scripts = [

test-utils = "dv tests/test_utils.dv"

test-preprocessing = "dv tests/test_preprocessing.dv"

test-metrics = "dv tests/test_metrics.dv"

test-linear = "dv tests/test_linear_model.dv"

test-neighbors = "dval tests/test_neighbors.dv"

test-trees = "dv tests/test_trees.dv"

tutorial = "dv src/main.dv"

quickstart = "dv examples/quickstart.dv"

]

# Same thing but with commas (both syntaxes should work)

tools = [

linter = "dv tools/linter.dv",

formatter = "dv tools/formatter.dv",

bundler = "dv tools/bundler.dv",

]

# List without commas

authors = [

"Alice"

"Bob"

"Charlie"

]

# List with commas

keywords = ["dv", "quest", "rpg", "toolkit"]
